<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	<PackageId>SlugEnt.$(AssemblyName)</PackageId>
	<Title>DirectoryServices.Protocols C# Library</Title>
	<Authors>Scott Herrmann</Authors>
	<Company>SlugEnt</Company>
	<Product>SlugEnt.$(AssemblyName)</Product>
	<Description>Provides objects for more easily working with Active Directory, such as groups, users, Ou's, password policies, etc</Description>
	<Copyright>2026</Copyright>
	<PackageProjectUrl>https://github.com/SlugEnt/AD.Protocols</PackageProjectUrl>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/SlugEnt/AD.Protocols</RepositoryUrl>
	<PackageReleaseNotes>Alpha Release</PackageReleaseNotes>
	<AssemblyName>SlugEnt.$(MSBuildProjectName)</AssemblyName>
	<RootNamespace>SlugEnt.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	<Version>0.7.1.0</Version>
	<Configurations>Debug;Release;Nuget</Configurations>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.86.1" />
    <PackageReference Include="SlugEnt.FluentResults" Version="3.18.0.3" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.10" />
  </ItemGroup>


	<!-- Source Link for GitHub -->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>



	<!-- Add this group to expose internals -->
	<ItemGroup>
		<InternalsVisibleTo Include="Test.ADProtocols" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<PropertyGroup>
		<!-- Instruct the SDK to output symbols -->
		<IncludeSymbols>true</IncludeSymbols>
		<!-- Use the modern snupkg format instead of the old legacy format -->
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- Ensure portable/cross-platform PDB files are created -->
		<DebugType>portable</DebugType>
	</PropertyGroup>
</Project>
